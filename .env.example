# API REST (inclui /api no final ou não — o serviço adiciona /api)
VITE_API_BASE_URL=http://localhost:3001/api

# WebSocket (host do backend, sem /api)
VITE_WS_URL=http://localhost:3001

# Google Maps — Maps JavaScript API (Google Cloud Console)
VITE_GOOGLE_MAPS_API_KEY=

# Firebase (web client SDK) — Firebase Console > Configurações do projeto
# VITE_USE_FIREBASE=true
# Banco Firestore nomeado (backend: FIRESTORE_DATABASE_ID com o mesmo valor)
# VITE_FIRESTORE_DATABASE_ID=db252-borderless
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=borderless-92b2c
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=

# Em produção o cadastro público fica desabilitado por padrão
# VITE_ALLOW_PUBLIC_REGISTER=true
